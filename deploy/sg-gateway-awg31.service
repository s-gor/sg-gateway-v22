[Unit]
Description=SG-Gateway independent AWG 3.1 userspace profile
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/sg-gateway/deploy/sg-gateway-awg31-userspace.sh
Restart=on-failure
RestartSec=2
RuntimeDirectory=amneziawg
StateDirectory=sg-gateway/awg31

[Install]
WantedBy=multi-user.target
